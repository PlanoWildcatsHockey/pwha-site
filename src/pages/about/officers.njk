---
title: PWHA Officers
permalink: /about/officers/index.html
description: The current officers of the Plano Wildcats Hockey Association.
layout: page
---

<div class="flow" style="--flow-space: var(--space-l)">

  <p>
    The Plano Wildcats Hockey Association is a parent-run organization.
    Officers serve on a volunteer basis and are elected each season.
  </p>

  {% if officers.current.length %}
    <section>
      <h2 class="section-heading-accent">{{ officers.currentSeason }} Officers</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Role</th>
              <th scope="col">Officer</th>
              <th scope="col">Contact</th>
            </tr>
          </thead>
          <tbody>
            {% for o in officers.current %}
              <tr>
                <td data-label="Role">{{ o.role }}</td>
                <td data-label="Officer">{{ o.name }}</td>
                <td data-label="Contact">
                  {% if o.email %}
                    <a href="mailto:{{ o.email }}">Email</a>
                  {% else %}
                    —
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  {% endif %}

  <p>For general inquiries, use the <a href="/contact/">Contact Us</a> page.</p>

  {# Past boards — all seasons except the current one #}
  {% if officers.bySeason.length > 1 %}
    <section>
      <h2 class="section-heading-accent">Past Boards</h2>
      <div class="flow" style="--flow-space: var(--space-m)">
        {% for entry in officers.bySeason %}
          {% if entry.season != officers.currentSeason %}
            <details>
              <summary style="font-weight: var(--font-bold); cursor: pointer;">{{ entry.season }}</summary>
              <div class="table-wrap" style="margin-block-start: var(--space-xs)">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">Role</th>
                      <th scope="col">Officer</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for o in entry.officers %}
                      <tr>
                        <td data-label="Role">{{ o.role }}</td>
                        <td data-label="Officer">{{ o.name }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

</div>
