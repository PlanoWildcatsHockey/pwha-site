---
layout: base
permalink: /index.html
title: 'Plano Wildcats Hockey Association'
description: 'The official site of the Plano Wildcats Hockey Association — supporting Plano Senior High School hockey.'
news:
  title: 'Latest News'
  intro: 'Recent posts and announcements from PWHA.'
---

<div class="wrapper">

  {# ── Hero ── #}
  <header class="full | section hero-section" style="--spot-color: var(--color-primary)">
    <div class="section__inner">
      <div class="wrapper">
        <div class="hero-content flow" style="--flow-space: var(--space-m-l)">
          <h1 style="color: var(--color-light);">Plano Senior<br>Wildcats Hockey</h1>
          <p class="hero-lead">
            Supporting Plano Senior High School hockey — Varsity, Junior Varsity, players, families, and alumni.
          </p>
          <div class="cluster" style="--gutter: var(--space-s)">
            <a href="/support/" class="button hero-btn-primary">Join the Club</a>
            <a href="/schedule/" class="button hero-btn-ghost">Team Schedule</a>
          </div>
        </div>
      </div>
    </div>
    {% svg "divider/waves", null, "divider" %}
  </header>

  {# ── Stat bar ── #}
  <section class="full | stat-bar">
    <div class="wrapper">
      <ul class="stats-grid" role="list">
        <li class="stat-item">
          <span class="stat-number">{{ season.name }}</span>
          <span class="stat-label">Active Season</span>
        </li>
        <li class="stat-item">
          <span class="stat-number">2 Teams</span>
          <span class="stat-label">Varsity &amp; JV</span>
        </li>
        <li class="stat-item">
          <span class="stat-number">{{ season.league.division }}</span>
          <span class="stat-label">{{ season.league.shortName }} Division</span>
        </li>
        <li class="stat-item">
          <span class="stat-number">DFW</span>
          <span class="stat-label">Rinks &amp; Tournaments</span>
        </li>
      </ul>
    </div>
  </section>

  {# ── Latest news ── #}
  <section class="full | region">
    <div class="wrapper flow">
      <div class="repel">
        <h2 class="section-heading-accent">{{ news.title }}</h2>
        <a href="/blog/" class="button" data-small-button data-button-variant="primary">View All</a>
      </div>
      {% if news.intro %}
        <p>{{ news.intro }}</p>
      {% endif %}
      <div class="region region-space-l">
        <custom-masonry layout="50-50">
          {% set itemList = collections.allPosts %}
          {% if itemList.length %}
            {% asyncEach item in itemList.slice(0, 4) %}
              {% set headingLevel = "h3" %}
              {% include "partials/card-blog.njk" %}
            {% endeach %}
          {% else %}
            <p><em>No news posts yet — once real posts are published, they'll appear here.</em></p>
          {% endif %}
        </custom-masonry>
      </div>
    </div>
  </section>

</div>
