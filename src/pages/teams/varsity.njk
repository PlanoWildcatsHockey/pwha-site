---
title: Varsity
permalink: /teams/varsity/index.html
description: The Plano Wildcats Varsity hockey roster and coaching staff.
layout: page
---

<div class="flow" style="--flow-space: var(--space-l)">

  <p>
    The Plano Wildcats Varsity team competes in the <strong>{{ season.league.division }}</strong>
    division of the {{ season.league.name }} during the {{ season.name }} season.
  </p>

  <aside class="league-links flow" style="--flow-space: var(--space-xs)">
    <p class="league-links__label">Official {{ season.name }} stats from the {{ season.league.shortName }}</p>
    <div class="cluster" style="--gutter: var(--space-xs)">
      <a href="{{ season.varsity.rosterUrl }}" class="button" data-small-button target="_blank" rel="noopener">Roster</a>
      <a href="{{ season.varsity.scheduleUrl }}" class="button" data-small-button target="_blank" rel="noopener">Schedule</a>
      <a href="{{ season.varsity.scoresUrl }}" class="button" data-small-button target="_blank" rel="noopener">Results</a>
      <a href="{{ season.varsity.statsUrl }}" class="button" data-small-button target="_blank" rel="noopener">Stats</a>
    </div>
  </aside>

  {# ── Roster ── #}
  {% set roster = players | playersInSeason(season.id, "varsity") %}
  <section>
    <h2 class="section-heading-accent">Roster</h2>
    {% set rosterLabel = season.name + " Varsity roster" %}
    {% set emptyMessage = "No Varsity players found for the current season." %}
    {% include "partials/roster-table.njk" %}
  </section>

  {# ── Coaching Staff ── #}
  {% set staff = coaches | filterCurrentStaff("varsity") %}
  <section>
    <h2 class="section-heading-accent">Coaching Staff</h2>
    {% if staff.length %}
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Role</th>
              <th scope="col">Name</th>
            </tr>
          </thead>
          <tbody>
            {% for c in staff %}
              <tr>
                <td data-label="Role">{{ c.role }}</td>
                <td data-label="Name">
                  {{ c.name }}
                  {% if c.email %}
                    <a href="mailto:{{ c.email }}" aria-label="Email {{ c.name }}" style="margin-inline-start: var(--space-xs)">✉</a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p><em>Coaching staff not yet entered.</em></p>
    {% endif %}
  </section>

</div>
