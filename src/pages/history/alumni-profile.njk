---
layout: base
pagination:
  data: alumni
  size: 1
  alias: player
permalink: "history/alumni/{{ player.slug }}/index.html"
eleventyComputed:
  title: "{{ player.name }} — Plano Wildcats Alumni"
  description: "{{ player.name }}, Plano Wildcats Hockey alumnus — Class of {{ player.gradYear }}."
---

<div class="wrapper">
  <article class="flow region" style="--flow-space: var(--space-l)">

    {# ── Memorial banner (shown when player has passed away) ── #}
    {% if player.dateOfDeath %}
      <div class="memorial-banner" role="note">
        <p>
          In memory of <strong>{{ player.name }}</strong>,
          who passed away on {{ player.dateOfDeath | formatDate("MMMM D, YYYY") }}.
          {% if player.notes %}{{ player.notes }}.{% endif %}
          Forever a Wildcat.
        </p>
      </div>
    {% endif %}

    {# ── Header ── #}
    <header class="player-profile__header">
      <div class="player-profile__number" aria-label="Jersey number {{ player.number }}">
        {{ player.number if player.number else "#" }}
      </div>
      <div>
        <h1 class="player-profile__name">{{ player.name }}</h1>
        <ul class="player-profile__meta" role="list">
          {% if player.position and player.position != "P" %}
            <li class="player-profile__meta-item">{{ player.position }}</li>
          {% endif %}
          {% if player.gradYear and not player.dateOfDeath %}
            <li class="player-profile__meta-item">Class of {{ player.gradYear }}</li>
          {% endif %}
          {% if player.school %}
            <li class="player-profile__meta-item">{{ player.school }}</li>
          {% endif %}
          {% if player.dateOfDeath %}
            <li class="player-profile__meta-item">{{ player.dateOfDeath | formatDate("MMMM D, YYYY") }}</li>
          {% endif %}
          {% if player.member %}
            <li><span class="member-badge">Member</span></li>
          {% endif %}
        </ul>
      </div>
    </header>

    {# ── After Plano (members or anyone with college data) ── #}
    {% if player.college or player.collegeHockey or player.postHsHockey %}
      <section class="flow" style="--flow-space: var(--space-s)">
        <h2 class="section-heading-accent">After Plano</h2>
        <dl class="flow" style="--flow-space: var(--space-xs)">
          {% if player.college %}
            <div>
              <dt style="font-weight: var(--font-bold); text-transform: uppercase; font-size: var(--size-step-min-1); letter-spacing: 0.08em;">College</dt>
              <dd>{{ player.college }}</dd>
            </div>
          {% endif %}
          {% if player.collegeHockey %}
            <div>
              <dt style="font-weight: var(--font-bold); text-transform: uppercase; font-size: var(--size-step-min-1); letter-spacing: 0.08em;">College Hockey</dt>
              <dd>{{ player.collegeHockey }}{% if player.collegeHockeyLevel %} ({{ player.collegeHockeyLevel }}){% endif %}</dd>
            </div>
          {% endif %}
          {% if player.postHsHockey %}
            <div>
              <dt style="font-weight: var(--font-bold); text-transform: uppercase; font-size: var(--size-step-min-1); letter-spacing: 0.08em;">Also Plays</dt>
              <dd>{{ player.postHsHockey }}</dd>
            </div>
          {% endif %}
        </dl>
      </section>
    {% endif %}

    {# ── Plano Career ── #}
    {% if player.seasons.length %}
      <section class="flow" style="--flow-space: var(--space-s)">
        <h2 class="section-heading-accent">Plano Career</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Season</th>
                <th scope="col">Team</th>
                <th scope="col">#</th>
                <th scope="col">Role</th>
              </tr>
            </thead>
            <tbody>
              {% for s in player.seasons | sort(true, false, "sortOrder") %}
                <tr>
                  <td>{{ s.seasonName }}</td>
                  <td>{{ "Varsity" if s.team == "varsity" else "Junior Varsity" }}</td>
                  <td>{{ s.number if s.number else "—" }}</td>
                  <td>
                    {% if s.captain == "C" %}<span class="captain-badge">C</span> Captain
                    {% elif s.captain == "A" %}<span class="captain-badge">A</span> Alternate
                    {% else %}—{% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    {% endif %}

    {# ── Connect (members with social links only) ── #}
    {% if player.member and (player.website or player.instagram or player.twitter or player.linkedin or player.facebook) %}
      <section class="flow" style="--flow-space: var(--space-s)">
        <h2 class="section-heading-accent">Connect</h2>
        <div class="profile-links">
          {% if player.website %}
            <a href="{{ player.website }}" class="button" data-small-button target="_blank" rel="noopener">Website</a>
          {% endif %}
          {% if player.instagram %}
            <a href="https://instagram.com/{{ player.instagram }}" class="button" data-small-button target="_blank" rel="noopener">Instagram</a>
          {% endif %}
          {% if player.twitter %}
            <a href="https://x.com/{{ player.twitter }}" class="button" data-small-button target="_blank" rel="noopener">X / Twitter</a>
          {% endif %}
          {% if player.linkedin %}
            <a href="{{ player.linkedin }}" class="button" data-small-button target="_blank" rel="noopener">LinkedIn</a>
          {% endif %}
          {% if player.facebook %}
            <a href="{{ player.facebook }}" class="button" data-small-button target="_blank" rel="noopener">Facebook</a>
          {% endif %}
        </div>
      </section>
    {% endif %}

    <p>
      <a href="/history/alumni/">&larr; Back to Alumni</a>
    </p>

  </article>
</div>
